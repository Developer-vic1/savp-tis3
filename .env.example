APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integración opcional con el aporte ingenieril
APORTE_INGENIERIL_ENABLED=false
APORTE_INGENIERIL_BASE_URL=http://127.0.0.1:8001
APORTE_INGENIERIL_REQUEST_TIMEOUT=120
APORTE_INGENIERIL_COLD_START_TIMEOUT=90
APORTE_INGENIERIL_CONNECT_TIMEOUT=3
APORTE_INGENIERIL_API_VERSION=v1
APORTE_INGENIERIL_HEALTH_PATH=/health
APORTE_INGENIERIL_ANALYSIS_PATH=
APORTE_INGENIERIL_KNOWLEDGE_PATH=
APORTE_INGENIERIL_KNOWLEDGE_GOVERNANCE_PATH=
APORTE_INGENIERIL_TUTOR_PATH=
# Debe coincidir con SAVP_AI_API_KEY y contener al menos 32 caracteres aleatorios.
APORTE_INGENIERIL_API_KEY=
APORTE_INGENIERIL_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Requiere tabla de notificaciones y productores institucionales aprobados.
SAVP_NOTIFICATIONS_ENABLED=false
SAVP_KARDEX_ENABLED=false
SAVP_CURRICULAR_UNITS_ENABLED=false
SAVP_ACADEMIC_GOALS_ENABLED=false
SAVP_INSTITUTIONAL_CALENDAR_ENABLED=false

# Dirección usada en los enlaces de bienvenida y recuperación.
SAVP_URL_ACCESO_PUBLICO=http://localhost:8000
