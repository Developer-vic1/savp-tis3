SAVP_AI_HOST=127.0.0.1
SAVP_AI_PORT=8001
# Obligatoria para cualquier ruta /api; use al menos 32 caracteres aleatorios.
SAVP_AI_API_KEY=
SAVP_AI_ENV=development
SAVP_AI_LOG_LEVEL=INFO
SAVP_AI_KNOWLEDGE_PATH=./data/processed
# Opcional: ruta persistente fuera del código para la cola de revisión.
# SAVP_AI_SOURCE_INTAKE_PATH=/var/lib/savp-aporte/source_intake.json
