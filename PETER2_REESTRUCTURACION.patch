+<?php
+
+namespace App\Services;
+
+use App\Models\Calificacion;
+use App\Models\User;
+use App\Services\AulaVirtual\CursoVirtualService;
+use Illuminate\Support\Facades\DB;
+
+class GradeService
+{
+    public function __construct(
+        private readonly CursoVirtualService $courses,
+        private readonly AcademicAccessService $access,
+    ) {}
+
+    public function gradesForTeacherCourse(User $user, string $courseId): array
+    {
+        $course = $this->courses->cursoParaDocente($user, $courseId);
+        abort_if(! $course, 403);
+
+        $studentIds = $course->estudiantes->where('est_cla_est', 'ACTIVO')->pluck('cod_est');
+        $grades = Calificacion::query()
+            ->with('estudiante.persona', 'asignatura', 'periodoEvaluacion')
+            ->where('cod_asi', $course->planAsignatura->cod_asi)
+            ->whereIn('cod_est', $studentIds)
+            ->orderBy('cod_est')
+            ->get();
+
+        return ['course' => $course, 'grades' => $grades];
+    }
+
+    public function update(User $user, Calificacion $grade, float $value, ?string $observation): void
+    {
+        abort_unless($user->canAny(['calificaciones.gestionar.curso', 'Calificaciones']), 403);
+        abort_unless($this->access->canManageGrade($user, $grade->cod_est, $grade->cod_asi), 403);
+
+        DB::transaction(function () use ($user, $grade, $value, $observation): void {
+            $before = ['nota' => $grade->not_cal, 'observacion' => $grade->obs_cal];
+            $grade->update(['not_cal' => $value, 'obs_cal' => $observation]);
+
+            BitacoraService::registrar(
+                accion: 'ACTUALIZAR_CALIFICACION_DOCENTE',
+                tabla: 'calificacion',
+                registro: $grade->cod_cal,
+                modulo: 'Calificaciones Docente',
+                descripcion: 'Se actualizó una calificación desde el curso asignado al docente.',
+                valoresAnteriores: $before,
+                valoresNuevos: ['nota' => $value, 'observacion' => $observation, 'actor' => $user->cod_usu]
+            );
+        });
+    }
+}
