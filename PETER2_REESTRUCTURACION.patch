+        return $actor->cod_usu === $target->cod_usu || $actor->hasRole('Administrador');
+    }
+
+    public function assignRoles(User $actor, User $target): bool
+    {
+        return $actor->hasRole('Administrador') && $actor->cod_usu !== $target->cod_usu;
+    }
+
+    public function deactivate(User $actor, User $target): bool
+    {
+        return $actor->hasRole('Administrador') && $actor->cod_usu !== $target->cod_usu;
+    }
+}
